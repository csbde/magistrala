# ==============================================================================
# Magistrala 物联网管理控制台 (单文件运行配置示例)
# 复制此文件为 config.env 即可生效：cp config.env.example config.env
# ==============================================================================

# 服务端口（默认 8080）
PORT=8080

# ------------------------------------------------------------------------------
# 外部 PostgreSQL 数据库配置 (核心设备/空间/用户数据持久化)
# ------------------------------------------------------------------------------
# 方式 1: 直接配置 DATABASE_URL 连接串 (推荐)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/magistrala?sslmode=disable

# 方式 2: 分项配置（当 DATABASE_URL 为空时生效）
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=magistrala

# ------------------------------------------------------------------------------
# JWT 会话签名密钥 (生产环境请务必修改)
# ------------------------------------------------------------------------------
MG_JWT_SECRET=super-secret-key-change-me-in-production-2026

# ------------------------------------------------------------------------------
# 企业级 OIDC / OAuth2 单点登录配置 (可选)
# 支持 Keycloak, Authing, Okta, Casdoor, GitLab, Google 等标准 OIDC 提供商
# ------------------------------------------------------------------------------
# OIDC 服务发现地址 (末尾需能拼接 /.well-known/openid-configuration)
# OIDC_ISSUER_URL=https://sso.example.com/realms/master
# OIDC_CLIENT_ID=magistrala-console
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=公司统一身份认证平台 (SSO)
# OIDC_SCOPES=openid,profile,email
